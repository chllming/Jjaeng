# Maintainer: Jjaeng contributors
pkgname=jjaeng-bin
pkgver=0.6.0
pkgrel=3
pkgdesc="Hyprland screenshot, recording, and MCP utility (prebuilt binary)"
arch=('x86_64')
url="https://github.com/chllming/Jjaeng"
license=('MIT' 'Apache-2.0')
depends=('gtk4' 'hyprland' 'grim' 'slurp' 'wl-clipboard')
optdepends=('gpu-screen-recorder: GPU-accelerated Wayland recording and combined audio'
            'ffmpeg: recording thumbnail extraction'
            'jjaeng-ocr-models: OCR text recognition support')
provides=('jjaeng')
conflicts=('jjaeng')
source=("$pkgname-$pkgver-x86_64.tar.gz::$url/releases/download/v$pkgver/jjaeng-x86_64-unknown-linux-gnu.tar.gz")
sha256sums=('SKIP')

package() {
  install -Dm755 "jjaeng" "$pkgdir/usr/bin/jjaeng"
  install -Dm755 "jjaengd" "$pkgdir/usr/bin/jjaengd"
  install -Dm755 "jjaeng-mcp" "$pkgdir/usr/bin/jjaeng-mcp"
  install -Dm755 "agent-screen" "$pkgdir/usr/bin/agent-screen"
  install -Dm644 "jjaengd.service" "$pkgdir/usr/lib/systemd/user/jjaengd.service"
}
